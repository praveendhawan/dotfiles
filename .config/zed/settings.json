// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
//
// Figma key is defined in jiffy project settings
// zed: open project settings
{
  "proxy": "",
  "language_models": {
    "openai_compatible": {
      "GLM": {
        "api_url": "https://api.z.ai/api/coding/",
        "available_models": [
          {
            "name": "GLM-5.2",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false
            }
          }
        ]
      },
      "Minimax": {
        "api_url": "https://api.minimax.io/v1",
        "available_models": [
          {
            "name": "MiniMax-M3",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false
            }
          },
          {
            "name": "MiniMax-M2.7",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false
            }
          }
        ]
      }
    }
  },
  "disable_ai": false,
  "project_panel": {
    "button": true,
  },
  "diff_view_style": "unified",
  "icon_theme": "Material Icon Theme",
  "session": {
    "trust_all_worktrees": true,
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "high",
      },
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_font_family": "FiraMono Nerd Font",
  "tab_size": 2,
  "soft_wrap": "prefer_line",
  "file_scan_inclusions": ["tmp/raw_dev/*"],
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "theme": "Ayu Dark",
  "ssh_connections": [],
  "agent": {
    "show_turn_stats": true,
    "sidebar_side": "left",
    "tool_permissions": {
      "default": "allow",
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-5",
    },
    "model_parameters": [],
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp", "rubocop", "!solargraph"],
    },
  },
  "lsp": {
    "rubocop": {
      "initialization_options": {
        "safeAutocorrect": false,
        "lintMode": true,
      },
    },
    "ruby-lsp": {
      "initialization_options": {
        "enabledFeatures": {
          // This disables diagnostics
          // Ruby LSP uses pull-based diagnostics which Zed doesn't support yet.
          // https://zed.dev/docs/languages/ruby#setting-up-ruby-lsp
          "diagnostics": false,
          "workspaceSymbol": true,
        },
      },
    },
  },
  "context_servers": {},
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "zed",
    "mode": "eager",
  },
}
